        "response": "CreateItemResponse",
        "module": "catalog",
        "error": "OperationError"
      },
      "cargo": {
        "manifest": "service/Cargo.toml",
        "package": "catalog-service",
        "target": "catalog-service",
        "features": [],
        "platform": "x86_64-unknown-linux-gnu",
        "profile": "release",
        "requiredFeatures": []
      },
      "schemas": {
        "request": "contracts/create-item.request.schema.json",
        "response": "contracts/create-item.response.schema.json"
      },
      "successStatus": 201,
      "errors": [
        {
          "variant": "InvalidName",
          "status": 400,
          "code": "invalid-name"
        },
        {
          "variant": "BackendFailure",
          "status": 500,
          "code": "backend-failure"
        }
      ]
    }
  ],
  "moduleMap": {
    "catalog": "service/src/handlers/create_item.rs"
