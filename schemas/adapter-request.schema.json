{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patamaps:draft:1:schema:adapter-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "documentType": {
      "const": "adapter-request"
    },
    "profile": {
      "const": "patamaps-workspace-draft-1"
    },
    "sourceId": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "digest",
              "byteLength"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "receipt",
          "content"
        ]
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "invocationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "profile",
    "sourceId",
    "namespace",
    "config",
    "inputs",
    "invocationDigest",
    "requestDigest"
  ]
}
