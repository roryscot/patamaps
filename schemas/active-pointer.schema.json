{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patamaps:draft:1:schema:active-pointer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "documentType": {
      "const": "active-pointer"
    },
    "consumer": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "consumer",
    "environment",
    "manifest"
  ]
}
