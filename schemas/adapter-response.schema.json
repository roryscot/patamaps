{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patamaps:draft:1:schema:adapter-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "documentType": {
      "const": "adapter-response"
    },
    "profile": {
      "const": "patamaps-workspace-draft-1"
    },
    "sourceId": {
      "type": "string"
    },
    "adapterVersion": {
      "type": "string"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "digest",
          "byteLength"
        ]
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "shard": {
      "$ref": "urn:patamaps:draft:1:schema:graph"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "message"
        ]
      },
      "maxItems": 1024,
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "profile",
    "sourceId",
    "adapterVersion",
    "requestDigest",
    "inputs",
    "shard",
    "diagnostics"
  ]
}
