{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patamaps:draft:1:schema:projection-spec",
  "title": "Patamaps draft projection-spec",
  "description": "A declarative, language-neutral request for a cardinality-checked static view of a viable graph generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "select",
    "slots",
    "documentType"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "documentType": {
      "const": "projection-spec"
    },
    "pathTree": {
      "$ref": "#/$defs/pathTree"
    },
    "metadata": {
      "$ref": "#/$defs/jsonObject"
    },
    "consumer": {
      "$ref": "#/$defs/identifier"
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "budget"
      ],
      "properties": {
        "consumer": {
          "$ref": "#/$defs/identifier"
        },
        "budget": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "relationIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "relation",
        "direction",
        "cardinality"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "relation": {
          "$ref": "#/$defs/relationIdentifier"
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming"
          ]
        },
        "cardinality": {
          "enum": [
            "exactly-one",
            "zero-or-one",
            "one-or-more",
            "many"
          ]
        },
        "targetKinds": {
          "$ref": "#/$defs/stringArray"
        },
        "allowLossy": {
          "type": "boolean"
        }
      }
    },
    "pathTree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "delimiter": {
          "enum": [
            "/",
            "--",
            "."
          ]
        }
      }
    }
  }
}
