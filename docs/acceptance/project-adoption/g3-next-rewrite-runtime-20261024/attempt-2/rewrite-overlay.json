    "rules": {
      "beforeFiles": [
        {
          "source": "/qualified/auth/:page(login|register)",
          "destination": "/:page",
          "has": [
            {
              "type": "header",
              "key": "x-patamaps-rewrite",
              "value": "enabled"
            }
          ],
          "missing": [
            {
              "type": "query",
              "key": "blocked"
            }
          ]
        }
      ],
      "afterFiles": [
        {
          "source": "/qualified/session",
          "destination": "/api/auth/session",
          "has": [
            {
              "type": "query",
              "key": "view",
              "value": "session"
            }
          ],
          "missing": [
            {
              "type": "header",
              "key": "x-patamaps-block"
            }
          ]
        }
      ],
      "fallback": []
    },
    "originalUpstreamUnchanged": true,
    "qualificationOverlay": true
  },
