{
  "profile": {
    "profile": "patamaps-chatbot-standalone-proxy-3",
    "upstreamConfigDigest": "sha256:856cc04806b203481ad9722b92d3f52907a618468ee79129f98373b4ae86e075",
    "rules": {
      "beforeFiles": [
        {
          "source": "/qualified/auth/:page(login|register)",
          "destination": "/:page",
          "has": [
            {
              "type": "header",
              "key": "x-patamaps-rewrite",
              "value": "enabled"
            }
          ],
          "missing": [
            {
              "type": "query",
              "key": "blocked"
            }
          ]
        }
      ],
      "afterFiles": [
        {
          "source": "/qualified/session",
          "destination": "http://127.0.0.1:44435/api/auth/session",
          "has": [
            {
              "type": "query",
              "key": "view",
              "value": "session"
            }
          ],
          "missing": [
            {
              "type": "header",
              "key": "x-patamaps-block"
            }
          ]
        }
      ],
      "fallback": []
    },
    "canonicalOwnerPort": 44435,
    "canonicalOwnerOrigin": "http://127.0.0.1:44435",
    "originalInternalSessionRewriteAccepted": false,
    "originalUpstreamUnchanged": true,
    "qualificationOverlay": true,
    "output": "standalone"
  },
  "profileDigest": "sha256:ab742bb6c64f21470d6951ab9c3b214967d5705d2eff2b7f084d65f9550d8c52",
