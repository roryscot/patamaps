{
  "profile": {
    "profile": "patamaps-chatbot-standalone-proxy-3",
    "upstreamConfigDigest": "sha256:856cc04806b203481ad9722b92d3f52907a618468ee79129f98373b4ae86e075",
    "rules": {
      "beforeFiles": [
        {
          "source": "/qualified/auth/:page(login|register)",
          "destination": "/:page",
          "has": [
            {
              "type": "header",
              "key": "x-patamaps-rewrite",
              "value": "enabled"
            }
          ],
          "missing": [
            {
              "type": "query",
              "key": "blocked"
            }
          ]
        }
      ],
      "afterFiles": [
        {
          "source": "/qualified/session",
          "destination": "http://127.0.0.1:46997/api/auth/session",
          "has": [
            {
              "type": "query",
              "key": "view",
              "value": "session"
            }
          ],
          "missing": [
            {
              "type": "header",
              "key": "x-patamaps-block"
            }
          ]
        }
      ],
      "fallback": []
    },
    "canonicalOwnerPort": 46997,
    "canonicalOwnerOrigin": "http://127.0.0.1:46997",
    "originalInternalSessionRewriteAccepted": false,
    "originalUpstreamUnchanged": true,
    "qualificationOverlay": true,
    "output": "standalone"
  },
  "profileDigest": "sha256:782b0254b21be5a52b474ff7b385df8d85503ac85ad23f17c2a6d22109870a4b",
