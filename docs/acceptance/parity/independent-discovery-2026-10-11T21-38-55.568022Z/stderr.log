\n            "byteLength": 1214,\n            "content": "{\\n  \\"schemaVersion\\": \\"0.1.0\\",\\n  \\"documentType\\": \\"policy\\",\\n  \\"id\\": \\"urn:bridge:policy\\",\\n  \\"graph\\": {\\n    \\"id\\": \\"urn:bridge:sssom-tsv\\",\\n    \\"revision\\": \\"1\\"\\n  },\\n  \\"mappings\\": [\\n    {\\n      \\"select\\": {\\n        \\"provenanceStatuses\\": [\\n          \\"observed\\",\\n          \\"declared\\"\\n        ]\\n      },\\n      \\"coverage\\": \\"partial\\",\\n      \\"determinism\\": \\"deterministic\\",\\n      \\"reversibility\\": \\"irreversible\\",\\n      \\"applicability\\": {\\n        \\"when\\": {\\n          \\"key\\": \\"useScientificAssertions\\",\\n          \\"operator\\": \\"equals\\",\\n          \\"value\\": true\\n        }\\n      }\\n    }\\n  ],\\n  \\"constraints\\": [],\\n  \\"evidence\\": [],\\n  \\"semantics\\": {\\n    \\"interpretation\\": \\"declared-law-application\\",\\n    \\"derivations\\": [],\\n    \\"derivationLimits\\": {\\n      \\"maxDepth\\": 8,\\n      \\"maxDerivations\\": 32\\n    },\\n    \\"assessments\\": [],\\n    \\"uncertaintyRequirements\\": [],\\n    \\"riskBudgets\\": [\\n      {\\n        \\"id\\": \\"urn:bridge:scientific-budget\\",\\n        \\"consumer\\": \\"urn:bridge:scientific-consumer\\",\\n        \\"classifications\\": [],\\n        \\"maximumTotalCost\\": 0,\\n        \\"maximumInferredMappings\\": 0,\\n        \\"maximumLossyMappings\\": 0,\\n        \\"requireCompleteClassification\\": true,\\n        \\"requireCompleteDependencies\\": true\\n      }\\n    ]\\n  }\\n}\\n"\n          },\n          {\n            "id": "urn:patamaps:workspace:authored:projection.json",\n            "locator": "workspace:projection.json",\n            "digest": "sha256:6b376c6d8be9a66ad4452147680c51f8d8648615c33fb1751d3744b15bdc17c0",\n            "byteLength": 311,\n            "content": "{\\n  \\"schemaVersion\\": \\"0.1.0\\",\\n  \\"documentType\\": \\"projection-spec\\",\\n  \\"id\\": \\"urn:bridge:projection\\",\\n  \\"select\\": {\\n    \\"kinds\\": [\\n      \\"explicitly-unselected:fixture\\"\\n    ]\\n  },\\n  \\"slots\\": [],\\n  \\"semantics\\": {\\n    \\"consumer\\": \\"urn:bridge:scientific-consumer\\",\\n    \\"budget\\": \\"urn:bridge:scientific-budget\\"\\n  }\\n}\\n"\n          },\n          {\n            "id": "urn:patamaps:workspace:authored:routing.json",\n            "locator": "workspace:routing.json",\n            "digest": "sha256:64cb8bad363e056b99e62fca7f1eca95c46790dcb0c4dd8c2f987c0ed4ff601f",\n            "byteLength": 2996,\n            "content": "{\\n  \\"schemaVersion\\": \\"0.1.0\\",\\n  \\"id\\": \\"urn:metamap:relation-pack:routing\\",\\n  \\"version\\": \\"1.0.0\\",\\n  \\"description\\": \\"Semantic relations for commands, events, routes, handlers, schemas, policies, and endpoints.\\",\\n  \\"relations\\": [\\n    {\\n      \\"id\\": \\"routing:handled_by\\",\\n      \\"description\\": \\"The target handler executes the source command, event, or route.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:command\\",\\n        \\"routing:event\\",\\n        \\"routing:route\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:handler\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"routing:accepts\\",\\n      \\"description\\": \\"The source accepts input conforming to the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:command\\",\\n        \\"routing:event\\",\\n        \\"routing:route\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \