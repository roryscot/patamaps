          },\n            {\n              "schemaVersion": "0.1.0",\n              "documentType": "relation-pack",\n              "id": "urn:metamap:relation-pack:core",\n              "version": "1.0.0",\n              "description": "Minimal structural relations shared by language and domain adapters.",\n              "relations": [\n                {\n                  "id": "core:contains",\n                  "cyclePolicy": "forbid",\n                  "description": "The source structurally contains the target.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many",\n                    "many-to-many"\n                  ],\n                  "transitive": true,\n                  "impactDirection": "both"\n                },\n                {\n                  "id": "core:implements",\n                  "cyclePolicy": "forbid",\n                  "description": "The target is a physical realization of the source concept or contract.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many",\n                    "many-to-many"\n                  ],\n                  "impactDirection": "source-to-target"\n                },\n                {\n                  "id": "core:conforms_to",\n                  "cyclePolicy": "forbid",\n                  "description": "The source is constrained by the target schema or specification.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "many-to-one",\n                    "many-to-many"\n                  ],\n                  "impactDirection": "target-to-source"\n                },\n                {\n                  "id": "core:derives_from",\n                  "cyclePolicy": "forbid",\n                  "description": "The source is derived from the target.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many",\n                    "many-to-one",\n                    "many-to-many"\n                  ],\n                  "transitive": true,\n                  "impactDirection": "target-to-source"\n                },\n                {\n                  "id": "core:generates",\n                  "cyclePolicy": "forbid",\n                  "description": "The source deterministically or procedurally produces the target.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many",\n                    "many-to-many"\n                  ],\n                  "impactDirection": "source-to-target"\n                },\n                {\n                  "id": "core:depends_on",\n                  "cyclePolicy": "forbid",\n                  "description": "The source requires the target.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many",\n                    "many-to-many"\n                  ],\n                  "transitive": true,\n                  "impactDirection": "target-to-source"\n                },\n                {\n                  "id": "core:mirrors",\n                  "cyclePolicy": "allow",\n                  "description": "The source and target intentionally duplicate the same scoped facts.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "many-to-many"\n                  ],\n                  "symmetric": true,\n                  "impactDirection": "both"\n                },\n                {\n                  "id": "core:documents",\n                  "cyclePolicy": "allow",\n                  "description": "The source documentation describes the target.",\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many",\n                    "many-to-many"\n                  ],\n                  "impactDirection": "target-to-source"\n                