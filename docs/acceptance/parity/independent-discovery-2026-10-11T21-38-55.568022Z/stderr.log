 "forbid",\n                  "description": "The source hydration boundary activates the target client-rendered structure.",\n                  "sourceKinds": [\n                    "topology:hydration-boundary"\n                  ],\n                  "targetKinds": [\n                    "routing:route",\n                    "topology:page",\n                    "topology:container",\n                    "topology:component",\n                    "topology:boundary"\n                  ],\n                  "cardinalities": [\n                    "one-to-one",\n                    "one-to-many"\n                  ],\n                  "impactDirection": "both"\n                },\n                {\n                  "id": "topology:guarded_by",\n                  "cyclePolicy": "forbid",\n                  "description": "The source route or rendering scope is guarded by the target middleware.",\n                  "sourceKinds": [\n                    "routing:route",\n                    "topology:page",\n                    "topology:container"\n                  ],\n                  "targetKinds": [\n                    "topology:middleware"\n                  ],\n                  "cardinalities": [\n                    "one-to-one",\n                    "many-to-one",\n                    "many-to-many"\n                  ],\n                  "impactDirection": "target-to-source"\n                },\n                {\n                  "id": "topology:fallback_for",\n                  "cyclePolicy": "forbid",\n                  "description": "The source loading, error, not-found, or default boundary is the fallback for the target scope.",\n                  "sourceKinds": [\n                    "topology:boundary"\n                  ],\n                  "targetKinds": [\n                    "topology:segment",\n                    "routing:route",\n                    "topology:page",\n                    "topology:container"\n                  ],\n    