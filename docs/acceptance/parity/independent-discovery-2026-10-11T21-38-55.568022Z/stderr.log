\": \\"Retain private interfaces; inline the 1.0.0 version type; omit unimplemented runtime config parser/loader/version declarations and source-map locator\\"\\n    },\\n    {\\n      \\"path\\": \\"profiles/scientific-skos.json\\",\\n      \\"digest\\": \\"sha256:2b79e79f495f2c8a1fb2e7cd39ddf112e2306c26ad5a267762f9c38759b5ff57\\",\\n      \\"sourceOrigin\\": \\"relation-packs/scientific-skos.json\\",\\n      \\"sourceOriginDigest\\": \\"sha256:2b79e79f495f2c8a1fb2e7cd39ddf112e2306c26ad5a267762f9c38759b5ff57\\",\\n      \\"transformation\\": \\"Unmodified licensed bundled relation data; no relation-pack parser or policy implementation is extracted\\"\\n    }\\n  ]\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:adapters/discovery/references.js",\n            "locator": "workspace:adapters/discovery/references.js",\n            "digest": "sha256:bdb1da9a9a5e94695b8819e48e158cb339fe6c7b121f3dea501c55b591c2ce84",\n            "byteLength": 1104,\n            "content": "const IDENTIFIER_PATTERN = /^[A-Za-z][A-Za-z0-9+.-]*:\\\\S+$/;\\nconst RELATION_PATTERN = /^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$/;\\nexport function isReferenceIdentifier(value) {\\n    return typeof value === \\"string\\" && IDENTIFIER_PATTERN.test(value);\\n}\\nexport function isRelationIdentifier(value) {\\n    return typeof value === \\"string\\" && RELATION_PATTERN.test(value);\\n}\\nexport function makeUrn(namespace, kind, value) {\\n    const encoded = encodeURIComponent(value);\\n    return `urn:${namespace}:${kind}:${encoded}`;\\n}\\n/** Convert a repository-relative path or glob into a resolvable locator URI. */\\nexport function makeRepositoryUri(rawPath, repository = \\"workspace\\") {\\n    const normalized = rawPath.replaceAll(\\"\\\\\\\\\\", \\"/\\").replace(/^\\\\.\\\\//, \\"\\");\\n    const encodedPath = normalized\\n        .split(\\"/\\")\\n        .map((segment) => encodeURIComponent(segment))\\n        .join(\\"/\\");\\n    return `repo://${encodeURIComponent(repository)}/${encodedPath}`;\\n}\\nexport function hasAmbiguousPathLanguage(path) {\\n    return /\\\\s+or\\\\s+/i.test(path);\\n}\\nexport function isPathPattern(path) {\\n    return /[*?{}[\\\\]]/.test(path);\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:adapters/discovery/relation-pack.js",\n            "locator": "workspace:adapters/discovery/relation-pack.js",\n            "digest": "sha256:afba780baf7fe1967d140b1f8773d719962ababbc24235e5a15d3f5a95b62d8a",\n            "byteLength": 307,\n            "content": "import { canonicalDigest } from \\"./canonical.js\\";\\nimport { valueDigest } from \\"./stable.js\\";\\n\\n/** Digest source facts using their original versioned wire convention. */\\nexport function relationPackDigest(pack) {\\n  return pack.schemaVersion === \\"2.0.0\\"\\n    ? canonicalDigest(pack)\\n    : valueDigest(pack);\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:adapters/discovery/scientific-relations.js",\n            "locator": "workspace:adapters/discovery/scientific-relations.js",\n            "digest": "sha256:bc0e8172310cbecca6c46a77207859760b543368cf379ab26848a906e4028568",\n            "byteLength": 1028,\n            "content": "import { readFileSync } from \\"node:fs\\";\\n\\n// Fixed source-fact data; the Rust registry independently checks admitted use.\\nexport const SCIENTIFIC_SKOS_PREDICATES = Object.freeze({\\n  \\"http://www.w3.org/2004/02/skos/core#exactMatch\\": \\"scientific:exact-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#closeMatch\\": \\"scientific:close-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#broadMatch\\": \\"scientific:broad-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#narrowMatch\\": \\"scientific:narrow-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#relatedMatch\\":\\n    \\"scientific:related-match\\",\\n});\\nexport function scientificSkosRelationPack() {\\n  const pack = JSON.parse(\\n    readFileSync(\\n      new URL(\\"./profiles/scientific-skos.json\\", import.meta.url),\\n      \\"utf8\\",\\n    ),\\n  );\\n  if (\\n    pack.schemaVersion !== \\"2.0.0\\" ||\\n    pack.id !== \\"urn:metamap:relation-pack:scientific-skos\\" ||\\n    pack.version !== \\"1.0.0\\"\\n  ) {\\n    throw new Error(\\n      \\"Bundled scientific SKOS profile has an unexpected identity\\",\\n    );\\n  }\\n  return pack;\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:adapters/discovery/sssom.js",\n            "locator": "workspace:adapters/discovery/sssom.js",\n            "digest": "sha256:5a82afd1cae447c9f26b6043ed902fcedb790b975ba3adb575eed731aadb8ae5",\n            "byteLength": 123,\n            "content": "// Source parsing, validation, interpretation and export execute in Rust.\\nexport * from \\"patamaps-native-sdk-draft/sssom\\";\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:adapters/discovery/stable.js",\n            "locator": "workspace:adapters/discovery/stable.js",\n            "digest": "sha256:fca250a18b4414d03013d524cf7515f258982570effe806d0ffb73a8e72d6c4a",\n            "byteLength": 831,\n            "content": "import { createHash } from \\"node:crypto\\";\\nexport function stableValue(value) {\\n    if (Array.isArray(value))\\n        return value.map(stableValue);\\n    if (typeof value !== \\"object\\" || value === null)\\n        return value;\\n    return Object.fromEntries(Object.entries(value)\\n        .sort(([left], [right]) => left.localeCompare(right))\\n        .map(([key, child]) => [key, stableValue(child)]));\\n}\\nexport function stableJson(value, pretty = false) {\\n    return `${JSON.stringify(stableValue(value), null, pretty ? 2 : undefined)}\\\\n`;\\n}\\nexport function contentDigest(value) {\\n    return `sha256:${createHash(\\"sha256\\").update(value).digest(\\"hex\\")}`;\\n}\\nexport function valueDigest(value) {\\n    return contentDigest(stableJson(value));\\n}\\nexport function valuesEqual(left, right) {\\n    return stableJson(left) === stableJson(right);\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:adapters/metamap-process.mjs",\n            "locator": "workspace:adapters/metamap-process.mjs",\n            "digest": "sha256:18e1ea2f1dce7b7eb69f6f9a3b5ccf49c84c21b046e2c031fe4939af087e9ada",\n            "byteLength": 267,\n            "content": "// Historical entry name retained for workspace configurations. The providers\\n// and their pinned dependency are installed with Patamaps discovery. The\\n// optional old absolute package argument is accepted without loading it.\\nawait import(\\"./discovery/process.mjs\\");\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:mapping.data",\n            "locator": "workspace:mapping.data",\n            "digest": "sha256:0eafab5a5673563e0a7fc737f9470f4fb3a53ad29beb4bc8d6138f1b3a610b69",\n            "byteLength": 4620,\n            "content": "#mapping_set_id: https://w3id.org/sssom/commons/mouse-human/mappings/mp_hp_mgi_all.sssom.tsv\\n#mapping_set_title: All mappings of MP terms to HPO terms generated by MGI\\n#mapping_set_description: \\"Consolidated list of all HPO to MP mappings done by MGI. In the comments section the project that was the source of the list is listed. Some terms came from more than one source. The KidsFirst list was a list of HPO terms provided by the KidsFirst team from the set of terms used for patients in their cohorts. The scoliosis, Alzheimer, cleft palate, Down Syndrome, CHARGE Syndrome, Cornelia De Lange Syndrome, and COVID term sets were generated by MGI for symptoms or phenotypes associated with the disease. For the COVID set the references for each sign or symptom are listed in the Other column. Initially the mapping dates for the KidsFirst mappings were not tracked, so these were given the date of when we received the file (5/27/21).  The scoliosis, cleft palate, Down Syndrome, CHARGE Syndrome, and Cornelia De Lange Syndrome sets consist of MP terms that are associated with mouse models of scoliosis. For Down Syndrome, CHARGE Syndrome, and Cornelia De Lange Syndrome HPO terms associated with each disease were also pulled from the HPO files for mapping. The Alzheimer and COVID sets were created by identifying symptoms and signs for patients from the literature then identifying the relevant MP and HP terms and finally mapping the identified terms to terms in the other ontology. Use of skos mappings terms: exact match: MP term is the same as the HPO term, ignoring that the HP term applies only to humans; broad match: HPO term covers more than the MP term, ignoring the species restriction; narrow match: HPO term is more restricted than the MP term; related match: MP term and HPO term share some similarity but would not have a parent-child relation in a shared ontology.\\"\\n#creator_id:\\n# - orcid:0000-0003-4606-0597\\n# - orcid:0000-0002-6490-7723\\n# - orcid:0000-0003-2307-1226\\n# - ror:021sy4w91\\n# - wikidata:Q1951035\\n#license: https://creativecommons.org/licenses/by/4.0/\\n#object_source: obo:hp\\n#subject_source: obo:mp\\n#curie_map:\\n# HP: http://purl.obolibrary.org/obo/HP_\\n# MP: http://purl.obolibrary.org/obo/MP_\\n# skos: http://www.w3.org/2004/02/skos/core#\\n# orcid: https://orcid.org/\\n# ror: https://ror.org/\\n# wikidata: https://www.wikidata.org/wiki/\\n# obo: http://purl.obolibrary.org/obo/\\n# semapv: https://w3id.org/semapv/vocab/\\nobject_id\\tobject_label\\tpredicate_id\\tconfidence\\tsubject_id\\tsubject_label\\tmapping_justification\\tauthor_id\\tmapping_date\\tcomment\\tother\\nHP:0000016\\tUrinary retention\\tskos:exactMatch\\t1\\tMP:0003622\\tischuria\\tsemapv:ManualMappingCuration\\torcid:0000-0003-4606-0597\\t2022-08-02\\tscoliosis\\t\\nHP:0000033\\tAmbiguous genitalia male\\tskos:narrowMatch\\t1\\tMP:0009198\\tabnormal male genitalia morphology\\tsemapv:ManualMappingCuration\\torcid:0000-0003-4606-0597\\t2022-02-07\\tKidsFirst; existing annotations from J:15425, J:98554 annotations are scattered under various terms, https://github.com/mgijax/mammalian-phenotype-ontology/issues/3511\\t\\nHP:0000041\\tChordee\\tskos:closeMatch\\t0.7\\tMP:0003555\\tchordee\\tsemapv:ManualMappingCuration\\torcid:0000-0002-6490-7723\\t2021-09-20\\tKidsFirst; The MP term definition for chordee MP:0003555 specifies acute angulation of the penis upon erection and places chordee under abnormal penile erection MP:0001379, unlike HPO which places Chordee HP:0000041 under Abnormal penis morphology HP:0000036 and provides details on the direction of bowing and degree of angulation. I think the match is therefore close and the MP term should be placed under both abnormal penile erection and morphology (see https://educalingo.com/en/dic-en/chordee)\\t\\nHP:0000104\\tRenal agenesis\\tskos:broadMatch\\t0.9\\tMP:0000520\\tabsent kidney\\tsemapv:ManualMappingCuration\\torcid:0000-0003-4606-0597\\t2021-05-27\\tKidsFirst; absence of both kidneys, HPO term has child terms for bilateral and unilateral renal agenesis that would be exact matches to the MP terms\\t\\nHP:0000219\\tThin upper lip vermilion\\tskos:relatedMatch\\t1\\tMP:0030168\\tthin upper lip\\tsemapv:ManualMappingCuration\\torcid:0000-0003-4606-0597\\t2022-02-11\\tKidsFirst\\t\\nHP:0000252\\tMicrocephaly\\tskos:narrowMatch\\t0.8\\tMP:0000433\\tmicrocephaly\\tsemapv:ManualMappingCuration\\torcid:0000-0003-4606-0597\\t2021-05-27\\tKidsFirst; MP specifies size not circumference and does not specify how much smaller\\t\\nHP:0000252\\tMicrocephaly\\tskos:narrowMatch\\t0.9\\tMP:0000433\\tmicrocephaly\\tsemapv:ManualMappingCuration\\torcid:0000-0003-4606-0597\\t2023-11-15\\tHPO term has specifics for when this would be called in humans that I interpret as more extreme than how the MP term would be applied\\t\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:node_modules/patamaps-native-sdk-draft/canonical.mjs",\n            "locator": "workspace:node_modules/patamaps-native-sdk-draft/canonical.mjs",\n            "digest": "sha256:3be5b66afd2b6618043964261bb07536f7c86dfc75b176ec4629e86c498710ac",\n            "byteLength": 6508,\n            "content": "import { spawnSync } from \\"node:child_process\\";\\nimport { isAbsolute } from \\"node:path\\";\\n\\nexport class CanonicalJsonError extends Error {\\n  constructor(code, message) {\\n    super(message);\\n    this.name = \\"CanonicalJsonError\\";\\n    this.code = code;\\n  }\\n}\\nconst fail = (code, message) => {\\n  throw new CanonicalJsonError(code, message);\\n};\\n\\nfunction unicode(value) {\\n  for (let index = 0; index < value.length; index++) {\\n    const code = value.charCodeAt(index);\\n    if (code >= 0xd800 && code <= 0xdbff) {\\n      const next = value.charCodeAt(++index);\\n      if (!(next >= 0xdc00 && next <= 0xdfff))\\n        fail(\\"INVALID_JSON_UNICODE\\", \\"Unpaired high surrogate\\");\\n    } else if (code >= 0xdc00 && code <= 0xdfff)\\n      fail(\\"INVALID_JSON_UNICODE\\", \\"Unpaired low surrogate\\");\\n  }\\n}\\n\\n/** Marshal JavaScript values without executing getters or toJSON hooks.\\n * Undefined, symbols and prototypes cannot survive JSON transport, so they\\n * must be checked here. Ordering, encoding and hashing belong to Rust.\\n */\\nfunction portable(value, legacy = false) {\\n  const ancestors = new Set();\\n  function copy(item, depth) {\\n    if (depth > 512)\\n      fail(\\"JSON_DEPTH_LIMIT\\", \\"Canonical JSON exceeds 512 levels\\");\\n    if (item === null || typeof item === \\"boolean\\") return item;\\n    if (typeof item === \\"string\\") {\\n      unicode(item);\\n      return item;\\n    }\\n    if (typeof item === \\"number\\") {\\n      if (!Number.isFinite(item))\\n        fail(\\n          \\"INVALID_JSON_VALUE\\",\\n          \\"JSON numbers must be finite IEEE-754 values\\",\\n        );\\n      return item;\\n    }\\n    if (typeof item !== \\"object\\")\\n      fail(\\"INVALID_JSON_VALUE\\", \\"Expected JSON-compatible values\\");\\n    if (ancestors.has(item)) fail(\\"INVALID_JSON_VALUE\\", \\"Cyclic JSON value\\");\\n    if (Object.getOwnPropertySymbols(item).length)\\n      fail(\\"INVALID_JSON_VALUE\\", \\"Symbol properties are not JSON\\");\\n    const descriptors = Object.getOwnPropertyDescriptors(item);\\n    for (const descriptor of Object.values(descriptors)) {\\n      if (!Object.hasOwn(descriptor, \\"value\\"))\\n        fail(\\"INVALID_JSON_VALUE\\", \\"Accessors are not JSON values\\");\\n    }\\n    ancestors.add(item);\\n    let result;\\n    if (Array.isArray(item)) {\\n      if (Object.getOwnPropertyNames(item).length !== item.length + 1)\\n        fail(\\n          \\"INVALID_JSON_VALUE\\",\\n          \\"Sparse arrays and extra array properties are not JSON\\",\\n        );\\n      result = [];\\n      Object.setPrototypeOf(result, null);\\n      for (let index = 0; index < item.length; index++) {\\n        if (!Object.hasOwn(item, index))\\n          fail(\\"INVALID_JSON_VALUE\\", \\"Sparse arrays are not JSON\\");\\n        result[index] = copy(descriptors[index].value, depth + 1);\\n      }\\n    } else {\\n      const prototype = Object.getPrototypeOf(item);\\n      if (prototype !== Object.prototype && prototype !== null)\\n        fail(\\"INVALID_JSON_VALUE\\", \\"Expected a plain JSON object\\");\\n      result = Object.create(null);\\n      for (const [key, descriptor] of Object.entries(descriptors)) {\\n        unicode(key);\\n        if (!descriptor.enumerable)\\n          fail(\\n            \\"INVALID_JSON_VALUE\\",\\n            \\"Nonenumerable object fields are not JSON\\",\\n          );\\n        if (legacy && descriptor.value === undefined) continue;\\n        result[key] = copy(descriptor.value, depth + 1);\\n      }\\n    }\\n    ancestors.delete(item);\\n    return result;\\n  }\\n  return JSON.stringify(copy(value, 0));\\n}\\n\\n/** @internal JSON marshalling shared by the native SDK transports. */\\nexport const marshalJson = (value) => portable(value);\\n\\n/** Object-based API backed by an explicitly selected native executable. */\\nexport function createCanonicalApi(executable, observeExecution) {\\n  if (!isAbsolute(executable))\\n    throw new TypeError(\\"Patamaps requires an absolute native executable\\");\\n  function invoke(operation, input) {\\n    const command = [executable, \\"json\\", operation];\\n    const result = spawnSync(executable, command.slice(1), {\\n      input,\\n      encoding: \\"utf8\\",\\n      env: {},\\n      timeout: 65_000,\\n      maxBuffer: 16 * 1024 * 1024 + 1,\\n    });\\n    observeExecution?.({\\n      command,\\n      input,\\n      exitCode: result.status,\\n      signal: result.signal,\\n      stdout: result.stdout ?? \\"\\",\\n      stderr: result.stderr ?? \\"\\",\\n      processError: result.error?.message ?? null,\\n    });\\n    if (result.error) throw result.error;\\n    if (result.status !== 0) {\\n      const report = JSON.parse(result.stdout);\\n      if (report.status !== \\"refused\\" || !report.error)\\n        throw new Error(\\n          `Patamaps JSON transport failed (${result.status}): ${result.stdout}${result.stderr}`,\\n        );\\n      const error = new CanonicalJsonError(\\n        report.error.code,\\n        report.error.message,\\n      );\\n      error.nativeMessage = report.error.nativeMessage;\\n      throw error;\\n    }\\n    if (!result.stdout.endsWith(\\"\\\\n\\"))\\n      throw new Error(\\"Patamaps JSON transport is missing its framing LF\\");\\n    return result.stdout.slice(0, -1);\\n  }\\n  return Object.freeze({\\n    canonicalJson(value) {\\n      return invoke(\\"canonical\\", portable(value));\\n    },\\n    canonicalDigest(value) {\\n      return JSON.parse(invoke(\\"digest\\", portable(value)));\\n    },\\n    parseStrictJson(text) {\\n      if (typeof text !== \\"string\\") throw new TypeError(\\"Expected JSON text\\");\\n      // Unpaired literal units cannot survive UTF-8 transport. Preserve syntax\\n      // refusal precedence while refusing these untransportable values here.\\n      try {\\n        unicode(text);\\n      } catch (error) {\\n        try {\\n          JSON.parse(text);\\n        } catch {\\n          fail(\\"INVALID_JSON_SYNTAX\\", \\"Invalid JSON syntax\\");\\n        }\\n        throw error;\\n      }\\n      invoke(\\"parse\\", text);\\n      // Rust established validity; this ordinary host unmarshalling preserves\\n      // JavaScript\'s observable original property order.\\n      return JSON.parse(text);\\n    },\\n    legacyReferenceValue(value) {\\n      return JSON.parse(invoke(\\"parse\\", portable(value, true)));\\n    },\\n  });\\n}\\n\\nlet configured;\\nexport function configureCanonical(executable, observeExecution) {\\n  configured = createCanonicalApi(executable, observeExecution);\\n}\\nfunction api() {\\n  if (!configured) configureCanonical(process.env.PATAMAPS_EXECUTABLE ?? \\"\\");\\n  return configured;\\n}\\nexport const canonicalJson = (value) => api().canonicalJson(value);\\nexport const canonicalDigest = (value) => api().canonicalDigest(value);\\nexport const parseStrictJson = (text) => api().parseStrictJson(text);\\nexport const legacyReferenceValue = (value) =>\\n  api().legacyReferenceValue(value);\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:node_modules/patamaps-native-sdk-draft/index.mjs",\n            "locator": "workspace:node_modules/patamaps-native-sdk-draft/index.mjs",\n            "digest": "sha256:5f963f40f5907d15e88e5d24fa70e96fdc66e62d027edc13f7b96cbf8f9096fd",\n            "byteLength": 1255,\n            "content": "import { execFileSync } from \\"node:child_process\\";\\nimport { isAbsolute } from \\"node:path\\";\\nexport {\\n  CanonicalJsonError,\\n  createCanonicalApi,\\n  configureCanonical,\\n  canonicalJson,\\n  canonicalDigest,\\n  parseStrictJson,\\n  legacyReferenceValue,\\n} from \\"./canonical.mjs\\";\\n\\n/** Thin transport. Parsed JSON is wire data; use replay for verification. */\\nexport class Patamaps {\\n  constructor(executable) {\\n    if (!isAbsolute(executable))\\n      throw new Error(\\n        \\"Patamaps requires an absolute installed native executable\\",\\n      );\\n    this.executable = executable;\\n  }\\n  runJson(arguments_) {\\n    if (\\n      !Array.isArray(arguments_) ||\\n      arguments_.some((a) => typeof a !== \\"string\\")\\n    )\\n      throw new TypeError(\\"Use an argument vector\\");\\n    const output = execFileSync(this.executable, arguments_, {\\n      encoding: \\"utf8\\",\\n      env: {},\\n      timeout: 65_000,\\n      maxBuffer: 16 * 1024 * 1024,\\n    });\\n    return JSON.parse(output);\\n  }\\n  replay(path) {\\n    return this.runJson([\\"replay\\", path]);\\n  }\\n  generate(config, root) {\\n    return this.runJson([\\"generate\\", config, \\"--root\\", root]);\\n  }\\n  check(config, baseline, root) {\\n    return this.runJson([\\"check\\", config, baseline, \\"--root\\", root]);\\n  }\\n}\\n\\nexport * from \\"./sssom.mjs\\";\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:node_modules/patamaps-native-sdk-draft/package.json",\n            "locator": "workspace:node_modules/patamaps-native-sdk-draft/package.json",\n            "digest": "sha256:e3738fe650cbef2f87b1bccf0f74df94186be66a62cc416ce82a022db6c21752",\n            "byteLength": 410,\n            "content": "{\\n  \\"name\\": \\"patamaps-native-sdk-draft\\",\\n  \\"version\\": \\"0.1.0\\",\\n  \\"private\\": true,\\n  \\"type\\": \\"module\\",\\n  \\"exports\\": {\\n    \\".\\": {\\n      \\"types\\": \\"./index.d.ts\\",\\n      \\"import\\": \\"./index.mjs\\"\\n    },\\n    \\"./canonical\\": {\\n      \\"types\\": \\"./canonical.d.ts\\",\\n      \\"import\\": \\"./canonical.mjs\\"\\n    },\\n    \\"./sssom\\": {\\n      \\"types\\": \\"./sssom.d.ts\\",\\n      \\"import\\": \\"./sssom.mjs\\"\\n    }\\n  },\\n  \\"license\\": \\"Apache-2.0\\"\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:node_modules/patamaps-native-sdk-draft/sssom-profile.mjs",\n            "locator": "workspace:node_modules/patamaps-native-sdk-draft/sssom-profile.mjs",\n            "digest": "sha256:a37260f42d6b02c5900dbefa9477386667f5286079a7a1abd12495e3dc78e533",\n            "byteLength": 863,\n            "content": "// Generated by scripts/parity/sssom_profile.py; do not edit.\\nexport const SSSOM_BUILTIN_PREFIXES = Object.freeze({\\n  \\"owl\\": \\"http://www.w3.org/2002/07/owl#\\",\\n  \\"rdf\\": \\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\\",\\n  \\"rdfs\\": \\"http://www.w3.org/2000/01/rdf-schema#\\",\\n  \\"semapv\\": \\"https://w3id.org/semapv/vocab/\\",\\n  \\"skos\\": \\"http://www.w3.org/2004/02/skos/core#\\",\\n  \\"sssom\\": \\"https://w3id.org/sssom/\\",\\n  \\"xsd\\": \\"http://www.w3.org/2001/XMLSchema#\\",\\n  \\"linkml\\": \\"https://w3id.org/linkml/\\"\\n});\\nexport const SSSOM_PROPAGATABLE_SLOTS = Object.freeze([\\n  \\"subject_type\\",\\n  \\"subject_source\\",\\n  \\"subject_source_version\\",\\n  \\"object_type\\",\\n  \\"object_source\\",\\n  \\"object_source_version\\",\\n  \\"mapping_provider\\",\\n  \\"mapping_tool\\",\\n  \\"mapping_tool_version\\",\\n  \\"mapping_date\\",\\n  \\"subject_match_field\\",\\n  \\"object_match_field\\",\\n  \\"subject_preprocessing\\",\\n  \\"object_preprocessing\\"\\n]);\\n"\n          },\n          {\n            "id": "urn:bridge:source:sssom-tsv:node_modules/patamaps-native-sdk-draft/sssom.mjs",\n            "locator": "workspace:node_modules/patamaps-native-sdk-draft/sssom.mjs",\n            "digest": "sha256:ccc44eac40a38b892d42c33537a9f15915e1aa65c774e6dc78d129284a6bfb74",\n            "byteLength": 4385,\n            "content": "import { spawnSync } from \\"node:child_process\\";\\nimport { isAbsolute } from \\"node:path\\";\\nimport { marshalJson } from \\"./canonical.mjs\\";\\nexport {\\n  SSSOM_BUILTIN_PREFIXES,\\n  SSSOM_PROPAGATABLE_SLOTS,\\n} from \\"./sssom-profile.mjs\\";\\n\\nexport const SSSOM_MAX_BYTES = 64 * 1024 * 1024;\\nexport const SSSOM_FORMAT_VERSION = \\"1.0.0\\";\\nexport const SSSOM_ENTITY_PROFILE = \\"sssom-1.0-entity-tsv\\";\\nexport class SssomError extends Error {\\n  constructor(code, message) {\\n    super(message);\\n    this.name = \\"SssomError\\";\\n    this.code = code;\\n  }\\n}\\nfunction freeze(value) {\\n  if (value && typeof value === \\"object\\") {\\n    for (const child of Object.values(value)) freeze(child);\\n    Object.freeze(value);\\n  }\\n  return value;\\n}\\nfunction encoded(input) {\\n  if (typeof input === \\"string\\") marshalJson(input);\\n  else if (!(input instanceof Uint8Array))\\n    throw new TypeError(\\"Expected UTF-8 text or Uint8Array\\");\\n  const bytes =\\n    typeof input === \\"string\\"\\n      ? Buffer.from(input, \\"utf8\\")\\n      : Buffer.from(input.buffer, input.byteOffset, input.byteLength);\\n  if (bytes.length > SSSOM_MAX_BYTES)\\n    throw new SssomError(\\"SSSOM_SIZE_LIMIT\\", \\"SSSOM input exceeds 64 MiB\\");\\n  return bytes.toString(\\"base64\\");\\n}\\nexport function createSssomApi(executable, observeExecution) {\\n  if (!isAbsolute(executable))\\n    throw new TypeError(\\"Patamaps requires an absolute native executable\\");\\n  function invoke(operation, value, args = []) {\\n    const command = [executable, \\"sssom\\", \\"json\\", operation, ...args];\\n    const input = marshalJson(value);\\n    const result = spawnSync(executable, command.slice(1), {\\n      input,\\n      encoding: \\"utf8\\",\\n      env: {},\\n      timeout: 65_000,\\n      maxBuffer: 1024 * 1024 * 1024 + 1,\\n    });\\n    observeExecution?.({\\n      command,\\n      input,\\n      exitCode: result.status,\\n      signal: result.signal,\\n      stdout: result.stdout ?? \\"\\",\\n      stderr: result.stderr ?? \\"\\",\\n      processError: result.error?.message ?? null,\\n    });\\n    if (result.error) throw result.error;\\n    if (result.status !== 0) {\\n      const report = JSON.parse(result.stdout);\\n      if (report.status !== \\"refused\\" || !report.error)\\n        throw new Error(\\n          `Patamaps scientific transport failed (${result.status}): ${result.stdout}${result.stderr}`,\\n        );\\n      throw new SssomError(report.error.code, report.error.message);\\n    }\\n    if (!result.stdout.endsWith(\\"\\\\n\\"))\\n      throw new Error(\\n        \\"Patamaps scientific transport is missing its framing LF\\",\\n      );\\n    return freeze(JSON.parse(result.stdout.slice(0, -1)));\\n  }\\n  return Object.freeze({\\n    parseSssomTsv(input, externalMetadata) {\\n      return invoke(\\"parse\\", {\\n        input: encoded(input),\\n        ...(externalMetadata === undefined\\n          ? {}\\n          : { metadata: encoded(externalMetadata) }),\\n      });\\n    },\\n    parseSssomDocument(value) {\\n      return invoke(\\"document\\", value);\\n    },\\n    parseSssomSourceConfig(value) {\\n      return invoke(\\"source-config\\", value);\\n    },\\n    interpretSssomDocument(value) {\\n      return invoke(\\"interpret\\", value);\\n    },\\n    expandSssomCurie(value, prefixes) {\\n      return invoke(\\"expand\\", { value, prefixes });\\n    },\\n    exportSssomTsv(value, options = {}) {\\n      if (\\n        Object.keys(options).some((key) => key !== \\"condense\\") ||\\n        (options.condense !== undefined &&\\n          typeof options.condense !== \\"boolean\\")\\n      )\\n        throw new SssomError(\\n          \\"SSSOM_EXPORT_OPTIONS\\",\\n          \\"Only a boolean condense option is supported\\",\\n        );\\n      return invoke(\\"export\\", value, options.condense ? [\\"--condense\\"] : []);\\n    },\\n  });\\n}\\nlet configured;\\nexport function configureSssom(executable, observeExecution) {\\n  configured = createSssomApi(executable, observeExecution);\\n}\\nfunction api() {\\n  if (!configured) configureSssom(process.env.PATAMAPS_EXECUTABLE ?? \\"\\");\\n  return configured;\\n}\\nexport const parseSssomTsv = (input, metadata) =>\\n  api().parseSssomTsv(input, metadata);\\nexport const parseSssomDocument = (value) => api().parseSssomDocument(value);\\nexport const parseSssomSourceConfig = (value) =>\\n  api().parseSssomSourceConfig(value);\\nexport const interpretSssomDocument = (value) =>\\n  api().interpretSssomDocument(value);\\nexport const exportSssomTsv = (value, options) =>\\n  api().exportSssomTsv(value, options);\\nexport const expandSssomCurie = (value, prefixes) =>\\n  api().expandSssomCurie(value, prefixes);\\n"\n          },\n          {\n            "id": "urn:patamaps:workspace:authored:application-topology.json",\n            "locator": "workspace:application-topology.json",\n            "digest": "sha256:b68162b6ddf7844f45c736b0e7ffaf82eddd0711705c5a17e8709b0f51b347eb",\n            "byteLength": 8892,\n            "content": "{\\n  \\"schemaVersion\\": \\"0.1.0\\",\\n  \\"id\\": \\"urn:metamap:relation-pack:application-topology\\",\\n  \\"version\\": \\"1.0.0\\",\\n  \\"description\\": \\"Structural relations for applications, route implementations, containers, outlets, content, contexts, data loading, parameters, middleware, fallbacks, and hydration boundaries.\\",\\n  \\"relations\\": [\\n    {\\n      \\"id\\": \\"topology:contains\\",\\n      \\"description\\": \\"The source structural scope directly contains the target structural element.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:application\\",\\n        \\"topology:segment\\",\\n        \\"topology:outlet\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:segment\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:outlet\\",\\n        \\"topology:boundary\\",\\n        \\"topology:hydration-boundary\\",\\n        \\"routing:route\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"transitive\\": true,\\n      \\"impactDirection\\": \\"both\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:implemented_by\\",\\n      \\"description\\": \\"The target framework element implements the source semantic route.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:wraps\\",\\n      \\"description\\": \\"The source container is the nearest rendering parent of the target page or nested container.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"transitive\\": true,\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:rendered_in\\",\\n      \\"description\\": \\"The target is the nearest container that renders the source semantic route or page.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:container\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:has_outlet\\",\\n      \\"description\\": \\"The source container declares the target rendering outlet.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:outlet\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:fills_outlet\\",\\n      \\"description\\": \\"The source page or container supplies the target outlet.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:outlet\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"many-to-one\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"both\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:hosts_provider\\",\\n      \\"description\\": \\"The source rendering scope mounts the target context provider.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:container\\",\\n        \\"topology:page\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:context-provider\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:provides_context\\",\\n      \\"description\\": \\"The source scope makes the target context available to descendants.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:application\\",\\n        \\"topology:container\\",\\n        \\"topology:page\\",\\n        \\"topology:context-provider\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:context\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:requires_context\\",\\n      \\"description\\": \\"The source cannot be expressed unless the target context is provided in its active scope.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:component\\",\\n        \\"topology:content\\",\\n        \\"topology:loader\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:context\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:resolves_content\\",\\n      \\"description\\": \\"The target is an independently referenceable content source resolved by the source.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:component\\",\\n        \\"topology:outlet\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:content\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:loads\\",\\n      \\"description\\": \\"The source invokes the target loader to resolve data.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:component\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:loader\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:parameterized_by\\",\\n      \\"description\\": \\"The source route shape is parameterized by the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:produces\\",\\n      \\"description\\": \\"The source produces data conforming to the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:handler\\",\\n        \\"topology:loader\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:consumes\\",\\n      \\"description\\": \\"The source consumes data conforming to the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:component\\",\\n        \\"topology:hydration-boundary\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:hydrates\\",\\n      \\"description\\": \\"The source hydration boundary activates the target client-rendered structure.\\",\\n      \\"sourceKinds\\": [\\n        \\"topo