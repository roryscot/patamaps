675255afcda9a66c002c08e51a175e3254dc8e2d3ca3923356b","relation":"scientific:close-match","sources":["http://purl.obolibrary.org/obo/MP_0003555"],"targets":["http://purl.obolibrary.org/obo/HP_0000041"],"cardinality":"one-to-one","lossiness":"unknown","provenance":{"status":"observed","assertedBy":"scientific","sourceRevision":"fixture-r1"},"attributes":{"sssom":{"raw":{"author_id":"orcid:0000-0002-6490-7723","comment":"KidsFirst; The MP term definition for chordee MP:0003555 specifies acute angulation of the penis upon erection and places chordee under abnormal penile erection MP:0001379, unlike HPO which places Chordee HP:0000041 under Abnormal penis morphology HP:0000036 and provides details on the direction of bowing and degree of angulation. I think the match is therefore close and the MP term should be placed under both abnormal penile erection and morphology (see https://educalingo.com/en/dic-en/chordee)","confidence":"0.7","mapping_date":"2021-09-20","mapping_justification":"semapv:ManualMappingCuration","object_id":"HP:0000041","object_label":"Chordee","other":"","predicate_id":"skos:closeMatch","subject_id":"MP:0003555","subject_label":"chordee"},"fields":{"author_id":["orcid:0000-0002-6490-7723"],"comment":"KidsFirst; The MP term definition for chordee MP:0003555 specifies acute angulation of the penis upon erection and places chordee under abnormal penile erection MP:0001379, unlike HPO which places Chordee HP:0000041 under Abnormal penis morphology HP:0000036 and provides details on the direction of bowing and degree of angulation. I think the match is therefore close and the MP term should be placed under both abnormal penile erection and morphology (see https://educalingo.com/en/dic-en/chordee)","confidence":0.7,"mapping_date":"2021-09-20","mapping_justification":"semapv:ManualMappingCuration","object_id":"HP:0000041","object_label":"Chordee","object_source":"obo:hp","predicate_id":"skos:closeMatch","subject_id":"MP:0003555","subject_label":"chordee","s