t { marshalJson } from \\"./canonical.mjs\\";\\nexport {\\n  SSSOM_BUILTIN_PREFIXES,\\n  SSSOM_PROPAGATABLE_SLOTS,\\n} from \\"./sssom-profile.mjs\\";\\n\\nexport const SSSOM_MAX_BYTES = 64 * 1024 * 1024;\\nexport const SSSOM_FORMAT_VERSION = \\"1.0.0\\";\\nexport const SSSOM_ENTITY_PROFILE = \\"sssom-1.0-entity-tsv\\";\\nexport class SssomError extends Error {\\n  constructor(code, message) {\\n    super(message);\\n    this.name = \\"SssomError\\";\\n    this.code = code;\\n  }\\n}\\nfunction freeze(value) {\\n  if (value && typeof value === \\"object\\") {\\n    for (const child of Object.values(value)) freeze(child);\\n    Object.freeze(value);\\n  }\\n  return value;\\n}\\nfunction encoded(input) {\\n  if (typeof input === \\"string\\") marshalJson(input);\\n  else if (!(input instanceof Uint8Array))\\n    throw new TypeError(\\"Expected UTF-8 text or Uint8Array\\");\\n  const bytes =\\n    typeof input === \\"string\\"\\n      ? Buffer.from(input, \\"utf8\\")\\n      : Buffer.from(input.buffer, input.byteOffset, input.byteLength);\\n  if (bytes.length > SSSOM_MAX_BYTES)\\n    throw new SssomError(\\"SSSOM_SIZE_LIMIT\\", \\"SSSOM input exceeds 64 MiB\\");\\n  return bytes.toString(\\"base64\\");\\n}\\nexport function createSssomApi(executable, observeExecution) {\\n  if (!isAbsolute(executable))\\n    throw new TypeError(\\"Patamaps requires an absolute native executable\\");\\n  function invoke(operation, value, args = []) {\\n    const command = [executable, \\"sssom\\", \\"json\\", operation, ...args];\\n    const input = marshalJson(value);\\n    const result = spawnSync(executable, command.slice(1), {\\n      input,\\n      encoding: \\"utf8\\",\\n      env: {},\\n      timeout: 65_000,\\n      maxBuffer: 1024 * 1024 * 1024 + 1,\\n    });\\n    observeExecution?.({\\n      command,\\n      input,\\n      exitCode: result.status,\\n      signal: result.signal,\\n      stdout: result.stdout ?? \\"\\",\\n      stderr: result.stderr ?? \\"\\",\\n      processError: result.error?.message ?? null,\\n    });\\n    if (result.error) throw result.error;\\n    if (result.status !== 0) {\\n      const report = JSON.parse(result.stdout);\\n      if (report.status !== \\"refused\\" || !report.error)\\n        throw new Error(\\n          `Patamaps scientific transport failed (${result.status}): ${result.stdout}${result.stderr}`,\\n        );\\n      throw new SssomError(report.error.code, report.error.message);\\n    }\\n    if (!result.stdout.endsWith(\\"\\\\n\\"))\\n      throw new Error(\\n        \\"Patamaps scientific transport is missing its framing LF\\",\\n      );\\n    return freeze(JSON.parse(result.stdout.slice(0, -1)));\\n  }\\n  return Object.freeze({\\n    parseSssomTsv(input, externalMetadata) {\\n      return invoke(\\"parse\\", {\\n        input: encoded(input),\\n        ...(externalMetadata === undefined\\n          ? {}\\n          : { metadata: encoded(externalMetadata) }),\\n      });\\n    },\\n    parseSssomDocument(value) {\\n      return invoke(\\"document\\", value);\\n    },\\n    parseSssomSourceConfig(value) {\\n      return invoke(\\"source-config\\", value);\\n    },\\n    interpretSssomDocument(value) {\\n      return invoke(\\"interpret\\", value);\\n    },\\n    expandSssomCurie(value, prefixes) {\\n      return invoke(\\"expand\\", { value, prefixes });\\n    },\\n    exportSssomTsv(value, options = {}) {\\n      if (\\n        Object.keys(options).some((key) => key !== \\"condense\\") ||\\n        (options.condense !== undefined &&\\n          typeof options.condense !== \\"boolean\\")\\n      )\\n        throw new SssomError(\\n          \\"SSSOM_EXPORT_OPTIONS\\",\\n          \\"Only a boolean condense option is supported\\",\\n        );\\n      return invoke(\\"export\\", value, options.condense ? [\\"--condense\\"] : []);\\n    },\\n  });\\n}\\nlet configured;\\nexport function configureSssom(executable, observeExecution) {\\n  configured = createSssomApi(executable, observeExecution);\\n}\\nfunction api() {\\n  if (!configured) configureSssom(process.env.PATAMAPS_EXECUTABLE ?? \\"\\");\\n  return configured;\\n}\\nexport const parseSssomTsv = (input, metadata) =>\\n  api().parseSssomTsv(input, metadata);\\nexport const parseSssomDocument = (value) => api().parseSssomDocument(value);\\nexport const parseSssomSourceConfig = (value) =>\\n  api().parseSssomSourceConfig(value);\\nexport const interpretSssomDocument = (value) =>\\n  api().interpretSssomDocument(value);\\nexport const exportSssomTsv = (value, options) =>\\n  api().exportSssomTsv(value, options);\\nexport const expandSssomCurie = (value, prefixes) =>\\n  api().expandSssomCurie(value, prefixes);\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:node_modules/require-from-string/index.js",\n            "locator": "workspace:node_modules/require-from-string/index.js",\n            "digest": "sha256:cb059342a762b955997bf780f3693add176922727f2fa9f11fcaf1b3fc323239",\n            "byteLength": 866,\n            "content": "\'use strict\';\\n\\nvar Module = require(\'module\');\\nvar path = require(\'path\');\\n\\nmodule.exports = function requireFromString(code, filename, opts) {\\n\\tif (typeof filename === \'object\') {\\n\\t\\topts = filename;\\n\\t\\tfilename = undefined;\\n\\t}\\n\\n\\topts = opts || {};\\n\\tfilename = filename || \'\';\\n\\n\\topts.appendPaths = opts.appendPaths || [];\\n\\topts.prependPaths = opts.prependPaths || [];\\n\\n\\tif (typeof code !== \'string\') {\\n\\t\\tthrow new Error(\'code must be a string, not \' + typeof code);\\n\\t}\\n\\n\\tvar paths = Module._nodeModulePaths(path.dirname(filename));\\n\\n\\tvar parent = module.parent;\\n\\tvar m = new Module(filename, parent);\\n\\tm.filename = filename;\\n\\tm.paths = [].concat(opts.prependPaths).concat(paths).concat(opts.appendPaths);\\n\\tm._compile(code, filename);\\n\\n\\tvar exports = m.exports;\\n\\tparent && parent.children && parent.children.splice(parent.children.indexOf(m), 1);\\n\\n\\treturn exports;\\n};\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:node_modules/require-from-string/package.json",\n            "locator": "workspace:node_modules/require-from-string/package.json",\n            "digest": "sha256:c0002f7d4c7d7e2a885cf0f97226344902417c3a0980f2beca41962d2bc1f6d8",\n            "byteLength": 511,\n            "content": "{\\n  \\"name\\": \\"require-from-string\\",\\n  \\"version\\": \\"2.0.2\\",\\n  \\"description\\": \\"Require module from string\\",\\n  \\"license\\": \\"MIT\\",\\n  \\"repository\\": \\"floatdrop/require-from-string\\",\\n  \\"author\\": {\\n    \\"name\\": \\"Vsevolod Strukchinsky\\",\\n    \\"email\\": \\"floatdrop@gmail.com\\",\\n    \\"url\\": \\"github.com/floatdrop\\"\\n  },\\n  \\"engines\\": {\\n    \\"node\\": \\">=0.10.0\\"\\n  },\\n  \\"scripts\\": {\\n    \\"test\\": \\"mocha\\"\\n  },\\n  \\"files\\": [\\n    \\"index.js\\"\\n  ],\\n  \\"keywords\\": [\\n    \\"\\"\\n  ],\\n  \\"dependencies\\": {},\\n  \\"devDependencies\\": {\\n    \\"mocha\\": \\"*\\"\\n  }\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:shard.json",\n            "locator": "workspace:shard.json",\n            "digest": "sha256:02c84e8695bec0d5aa0d566aee8728a1fcaf1190c6a5939dbe3d4b0d870ca455",\n            "byteLength": 304,\n            "content": "{\\"schemaVersion\\": \\"2.0.0\\", \\"id\\": \\"urn:bridge:portable-source\\", \\"namespace\\": \\"bridge\\", \\"entities\\": [{\\"id\\": \\"urn:bridge:portable-item\\", \\"kind\\": \\"item\\", \\"label\\": \\"Portable item\\", \\"attributes\\": {\\"sourceExtension\\": {\\"preserved\\": true}}}], \\"mappings\\": [], \\"authorities\\": [], \\"metadata\\": {\\"declaredOnly\\": true}}"\n          },\n          {\n            "id": "urn:patamaps:workspace:authored:application-topology.json",\n            "locator": "workspace:application-topology.json",\n            "digest": "sha256:b68162b6ddf7844f45c736b0e7ffaf82eddd0711705c5a17e8709b0f51b347eb",\n            "byteLength": 8892,\n            "content": "{\\n  \\"schemaVersion\\": \\"0.1.0\\",\\n  \\"id\\": \\"urn:metamap:relation-pack:application-topology\\",\\n  \\"version\\": \\"1.0.0\\",\\n  \\"description\\": \\"Structural relations for applications, route implementations, containers, outlets, content, contexts, data loading, parameters, middleware, fallbacks, and hydration boundaries.\\",\\n  \\"relations\\": [\\n    {\\n      \\"id\\": \\"topology:contains\\",\\n      \\"description\\": \\"The source structural scope directly contains the target structural element.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:application\\",\\n        \\"topology:segment\\",\\n        \\"topology:outlet\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:segment\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:outlet\\",\\n        \\"topology:boundary\\",\\n        \\"topology:hydration-boundary\\",\\n        \\"routing:route\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"transitive\\": true,\\n      \\"impactDirection\\": \\"both\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:implemented_by\\",\\n      \\"description\\": \\"The target framework element implements the source semantic route.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:wraps\\",\\n      \\"description\\": \\"The source container is the nearest rendering parent of the target page or nested container.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"transitive\\": true,\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:rendered_in\\",\\n      \\"description\\": \\"The target is the nearest container that renders the source semantic route or page.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:container\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:has_outlet\\",\\n      \\"description\\": \\"The source container declares the target rendering outlet.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:outlet\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:fills_outlet\\",\\n      \\"description\\": \\"The source page or container supplies the target outlet.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:outlet\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"many-to-one\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"both\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:hosts_provider\\",\\n      \\"description\\": \\"The source rendering scope mounts the target context provider.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:container\\",\\n        \\"topology:page\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:context-provider\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:provides_context\\",\\n      \\"description\\": \\"The source scope makes the target context available to descendants.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:application\\",\\n        \\"topology:container\\",\\n        \\"topology:page\\",\\n        \\"topology:context-provider\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:context\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:requires_context\\",\\n      \\"description\\": \\"The source cannot be expressed unless the target context is provided in its active scope.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:component\\",\\n        \\"topology:content\\",\\n        \\"topology:loader\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:context\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:resolves_content\\",\\n      \\"description\\": \\"The target is an independently referenceable content source resolved by the source.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:component\\",\\n        \\"topology:outlet\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:content\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:loads\\",\\n      \\"description\\": \\"The source invokes the target loader to resolve data.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:component\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:loader\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:parameterized_by\\",\\n      \\"description\\": \\"The source route shape is parameterized by the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:produces\\",\\n      \\"description\\": \\"The source produces data conforming to the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:handler\\",\\n        \\"topology:loader\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"source-to-target\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:consumes\\",\\n      \\"description\\": \\"The source consumes data conforming to the target schema.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:page\\",\\n        \\"topology:component\\",\\n        \\"topology:hydration-boundary\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:schema\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\",\\n        \\"many-to-one\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"target-to-source\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:hydrates\\",\\n      \\"description\\": \\"The source hydration boundary activates the target client-rendered structure.\\",\\n      \\"sourceKinds\\": [\\n        \\"topology:hydration-boundary\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\",\\n        \\"topology:component\\",\\n        \\"topology:boundary\\"\\n      ],\\n      \\"cardinalities\\": [\\n        \\"one-to-one\\",\\n        \\"one-to-many\\"\\n      ],\\n      \\"cyclePolicy\\": \\"forbid\\",\\n      \\"impactDirection\\": \\"both\\"\\n    },\\n    {\\n      \\"id\\": \\"topology:guarded_by\\",\\n      \\"description\\": \\"The source route or rendering scope is guarded by the target middleware.\\",\\n      \\"sourceKinds\\": [\\n        \\"routing:route\\",\\n        \\"topology:page\\",\\n        \\"topology:container\\"\\n      ],\\n      \\"targetKinds\\": [\\n        \\"topology:middleware\\"\\n      ],