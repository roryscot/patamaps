    },\\n    {\\n      \\"path\\": \\"config.d.ts\\",\\n      \\"digest\\": \\"sha256:d69cd20951b07c4b867c5e1bf198e6ee0705c3b017affbc1071c39ae48e351c9\\",\\n      \\"compiledOrigin\\": \\"dist/config.d.ts\\",\\n      \\"compiledOriginDigest\\": \\"sha256:329a45279f0c4c37490f312df9f9f35f8cb34927eb0cd7882d91b26646a47204\\",\\n      \\"sourceOrigin\\": \\"src/config.ts\\",\\n      \\"sourceOriginDigest\\": \\"sha256:b5940f4c0aac22e5284007f97533f7dbc3fabbd7669e7738ed42fd0a4d3296bb\\",\\n      \\"transformation\\": \\"Retain private interfaces; inline the 1.0.0 version type; omit unimplemented runtime config parser/loader/version declarations and source-map locator\\"\\n    },\\n    {\\n      \\"path\\": \\"profiles/scientific-skos.json\\",\\n      \\"digest\\": \\"sha256:2b79e79f495f2c8a1fb2e7cd39ddf112e2306c26ad5a267762f9c38759b5ff57\\",\\n      \\"sourceOrigin\\": \\"relation-packs/scientific-skos.json\\",\\n      \\"sourceOriginDigest\\": \\"sha256:2b79e79f495f2c8a1fb2e7cd39ddf112e2306c26ad5a267762f9c38759b5ff57\\",\\n      \\"transformation\\": \\"Unmodified licensed bundled relation data; no relation-pack parser or policy implementation is extracted\\"\\n    },\\n    {\\n      \\"path\\": \\"schemas/metamap-graph.schema.json\\",\\n      \\"digest\\": \\"sha256:fa177ee438ac4cf55e133666c0c7a66e5c7bb0242deb78611e2e3482148bde72\\",\\n      \\"sourceOrigin\\": \\"schemas/metamap-graph.schema.json\\",\\n      \\"sourceOriginDigest\\": \\"sha256:fa177ee438ac4cf55e133666c0c7a66e5c7bb0242deb78611e2e3482148bde72\\",\\n      \\"transformation\\": \\"Unmodified licensed shard shape schema; semantic validation remains in the composed native workspace\\"\\n    }\\n  ]\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:adapters/discovery/references.js",\n            "locator": "workspace:adapters/discovery/references.js",\n            "digest": "sha256:bdb1da9a9a5e94695b8819e48e158cb339fe6c7b121f3dea501c55b591c2ce84",\n            "byteLength": 1104,\n            "content": "const IDENTIFIER_PATTERN = /^[A-Za-z][A-Za-z0-9+.-]*:\\\\S+$/;\\nconst RELATION_PATTERN = /^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$/;\\nexport function isReferenceIdentifier(value) {\\n    return typeof value === \\"string\\" && IDENTIFIER_PATTERN.test(value);\\n}\\nexport function isRelationIdentifier(value) {\\n    return typeof value === \\"string\\" && RELATION_PATTERN.test(value);\\n}\\nexport function makeUrn(namespace, kind, value) {\\n    const encoded = encodeURIComponent(value);\\n    return `urn:${namespace}:${kind}:${encoded}`;\\n}\\n/** Convert a repository-relative path or glob into a resolvable locator URI. */\\nexport function makeRepositoryUri(rawPath, repository = \\"workspace\\") {\\n    const normalized = rawPath.replaceAll(\\"\\\\\\\\\\", \\"/\\").replace(/^\\\\.\\\\//, \\"\\");\\n    const encodedPath = normalized\\n        .split(\\"/\\")\\n        .map((segment) => encodeURIComponent(segment))\\n        .join(\\"/\\");\\n    return `repo://${encodeURIComponent(repository)}/${encodedPath}`;\\n}\\nexport function hasAmbiguousPathLanguage(path) {\\n    return /\\\\s+or\\\\s+/i.test(path);\\n}\\nexport function isPathPattern(path) {\\n    return /[*?{}[\\\\]]/.test(path);\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:adapters/discovery/relation-pack.js",\n            "locator": "workspace:adapters/discovery/relation-pack.js",\n            "digest": "sha256:afba780baf7fe1967d140b1f8773d719962ababbc24235e5a15d3f5a95b62d8a",\n            "byteLength": 307,\n            "content": "import { canonicalDigest } from \\"./canonical.js\\";\\nimport { valueDigest } from \\"./stable.js\\";\\n\\n/** Digest source facts using their original versioned wire convention. */\\nexport function relationPackDigest(pack) {\\n  return pack.schemaVersion === \\"2.0.0\\"\\n    ? canonicalDigest(pack)\\n    : valueDigest(pack);\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:adapters/discovery/schemas/metamap-graph.schema.json",\n            "locator": "workspace:adapters/discovery/schemas/metamap-graph.schema.json",\n            "digest": "sha256:fa177ee438ac4cf55e133666c0c7a66e5c7bb0242deb78611e2e3482148bde72",\n            "byteLength": 7148,\n            "content": "{\\n  \\"$schema\\": \\"https://json-schema.org/draft/2020-12/schema\\",\\n  \\"$id\\": \\"https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-graph/v2.schema.json\\",\\n  \\"title\\": \\"Metamap relationship graph\\",\\n  \\"description\\": \\"Language-neutral identities, structural correspondences, and scoped authority declarations.\\",\\n  \\"type\\": \\"object\\",\\n  \\"additionalProperties\\": false,\\n  \\"required\\": [\\n    \\"schemaVersion\\",\\n    \\"id\\",\\n    \\"namespace\\",\\n    \\"entities\\",\\n    \\"mappings\\",\\n    \\"authorities\\"\\n  ],\\n  \\"properties\\": {\\n    \\"$schema\\": {\\n      \\"type\\": \\"string\\",\\n      \\"format\\": \\"uri-reference\\"\\n    },\\n    \\"schemaVersion\\": {\\n      \\"const\\": \\"2.0.0\\"\\n    },\\n    \\"id\\": {\\n      \\"$ref\\": \\"#/$defs/identifier\\"\\n    },\\n    \\"namespace\\": {\\n      \\"type\\": \\"string\\",\\n      \\"minLength\\": 1,\\n      \\"pattern\\": \\"^[A-Za-z][A-Za-z0-9._-]*$\\"\\n    },\\n    \\"label\\": {\\n      \\"type\\": \\"string\\",\\n      \\"minLength\\": 1\\n    },\\n    \\"revision\\": {\\n      \\"type\\": \\"string\\",\\n      \\"minLength\\": 1\\n    },\\n    \\"relationPacks\\": {\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"$ref\\": \\"#/$defs/relationPackReference\\"\\n      },\\n      \\"uniqueItems\\": true\\n    },\\n    \\"entities\\": {\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"$ref\\": \\"#/$defs/entity\\"\\n      }\\n    },\\n    \\"mappings\\": {\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"$ref\\": \\"#/$defs/mapping\\"\\n      }\\n    },\\n    \\"authorities\\": {\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"$ref\\": \\"#/$defs/authority\\"\\n      }\\n    },\\n    \\"metadata\\": {\\n      \\"$ref\\": \\"#/$defs/jsonObject\\"\\n    },\\n    \\"extensions\\": {\\n      \\"$ref\\": \\"#/$defs/jsonObject\\"\\n    }\\n  },\\n  \\"$defs\\": {\\n    \\"identifier\\": {\\n      \\"type\\": \\"string\\",\\n      \\"minLength\\": 3,\\n      \\"pattern\\": \\"^[A-Za-z][A-Za-z0-9+.-]*:[^\\\\\\\\s]+$\\"\\n    },\\n    \\"relationIdentifier\\": {\\n      \\"type\\": \\"string\\",\\n      \\"pattern\\": \\"^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$\\"\\n    },\\n    \\"jsonValue\\": {\\n      \\"oneOf\\": [\\n        { \\"type\\": \\"null\\" },\\n        { \\"type\\": \\"boolean\\" },\\n        { \\"type\\": \\"number\\" },\\n        { \\"type\\": \\"string\\" },\\n        {\\n          \\"type\\": \\"array\\",\\n          \\"items\\": { \\"$ref\\": \\"#/$defs/jsonValue\\" }\\n        },\\n        { \\"$ref\\": \\"#/$defs/jsonObject\\" }\\n      ]\\n    },\\n    \\"jsonObject\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": {\\n        \\"$ref\\": \\"#/$defs/jsonValue\\"\\n      }\\n    },\\n    \\"locator\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\"uri\\"],\\n      \\"properties\\": {\\n        \\"uri\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"mediaType\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n        \\"revision\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n        \\"digest\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 }\\n      }\\n    },\\n    \\"provenance\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\"status\\", \\"assertedBy\\"],\\n      \\"properties\\": {\\n        \\"status\\": {\\n          \\"enum\\": [\\"declared\\", \\"observed\\", \\"generated\\", \\"inferred\\"]\\n        },\\n        \\"assertedBy\\": {\\n          \\"type\\": \\"string\\",\\n          \\"minLength\\": 1\\n        },\\n        \\"observedAt\\": {\\n          \\"type\\": \\"string\\",\\n          \\"format\\": \\"date-time\\"\\n        },\\n        \\"sourceRevision\\": {\\n          \\"type\\": \\"string\\",\\n          \\"minLength\\": 1\\n        },\\n        \\"confidence\\": {\\n          \\"type\\": \\"number\\",\\n          \\"minimum\\": 0,\\n          \\"maximum\\": 1\\n        }\\n      }\\n    },\\n    \\"entity\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\"id\\", \\"kind\\"],\\n      \\"properties\\": {\\n        \\"id\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"kind\\": {\\n          \\"type\\": \\"string\\",\\n          \\"minLength\\": 1,\\n          \\"pattern\\": \\"^[A-Za-z][A-Za-z0-9._:-]*$\\"\\n        },\\n        \\"label\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n        \\"schema\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"locators\\": {\\n          \\"type\\": \\"array\\",\\n          \\"items\\": { \\"$ref\\": \\"#/$defs/locator\\" }\\n        },\\n        \\"attributes\\": { \\"$ref\\": \\"#/$defs/jsonObject\\" },\\n        \\"provenance\\": { \\"$ref\\": \\"#/$defs/provenance\\" }\\n      }\\n    },\\n    \\"transform\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\"adapter\\", \\"version\\"],\\n      \\"properties\\": {\\n        \\"adapter\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n        \\"version\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n        \\"entrypoint\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"deterministic\\": { \\"type\\": \\"boolean\\" },\\n        \\"reversible\\": { \\"type\\": \\"boolean\\" },\\n        \\"configuration\\": { \\"$ref\\": \\"#/$defs/jsonObject\\" }\\n      }\\n    },\\n    \\"mapping\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\n        \\"id\\",\\n        \\"relation\\",\\n        \\"sources\\",\\n        \\"targets\\",\\n        \\"cardinality\\",\\n        \\"lossiness\\",\\n        \\"provenance\\"\\n      ],\\n      \\"properties\\": {\\n        \\"id\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"relation\\": { \\"$ref\\": \\"#/$defs/relationIdentifier\\" },\\n        \\"sources\\": {\\n          \\"type\\": \\"array\\",\\n          \\"minItems\\": 1,\\n          \\"uniqueItems\\": true,\\n          \\"items\\": { \\"$ref\\": \\"#/$defs/identifier\\" }\\n        },\\n        \\"targets\\": {\\n          \\"type\\": \\"array\\",\\n          \\"minItems\\": 1,\\n          \\"uniqueItems\\": true,\\n          \\"items\\": { \\"$ref\\": \\"#/$defs/identifier\\" }\\n        },\\n        \\"cardinality\\": {\\n          \\"enum\\": [\\"one-to-one\\", \\"one-to-many\\", \\"many-to-one\\", \\"many-to-many\\"]\\n        },\\n        \\"lossiness\\": {\\n          \\"enum\\": [\\"lossless\\", \\"lossy\\", \\"unknown\\"]\\n        },\\n        \\"transform\\": { \\"$ref\\": \\"#/$defs/transform\\" },\\n        \\"invariants\\": {\\n          \\"type\\": \\"array\\",\\n          \\"items\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n          \\"uniqueItems\\": true\\n        },\\n        \\"attributes\\": { \\"$ref\\": \\"#/$defs/jsonObject\\" },\\n        \\"provenance\\": { \\"$ref\\": \\"#/$defs/provenance\\" }\\n      }\\n    },\\n    \\"authority\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\"id\\", \\"concept\\", \\"source\\", \\"facts\\", \\"mode\\", \\"provenance\\"],\\n      \\"properties\\": {\\n        \\"id\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"concept\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"source\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"facts\\": {\\n          \\"type\\": \\"array\\",\\n          \\"minItems\\": 1,\\n          \\"uniqueItems\\": true,\\n          \\"items\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 }\\n        },\\n        \\"mode\\": {\\n          \\"enum\\": [\\"canonical\\", \\"delegated\\", \\"candidate\\"]\\n        },\\n        \\"delegatedFrom\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"provenance\\": { \\"$ref\\": \\"#/$defs/provenance\\" }\\n      },\\n      \\"allOf\\": [\\n        {\\n          \\"if\\": {\\n            \\"properties\\": { \\"mode\\": { \\"const\\": \\"delegated\\" } },\\n            \\"required\\": [\\"mode\\"]\\n          },\\n          \\"then\\": {\\n            \\"properties\\": {\\n              \\"delegatedFrom\\": { \\"$ref\\": \\"#/$defs/identifier\\" }\\n            },\\n            \\"required\\": [\\"delegatedFrom\\"]\\n          },\\n          \\"else\\": { \\"not\\": { \\"required\\": [\\"delegatedFrom\\"] } }\\n        }\\n      ]\\n    },\\n    \\"relationPackReference\\": {\\n      \\"type\\": \\"object\\",\\n      \\"additionalProperties\\": false,\\n      \\"required\\": [\\"id\\", \\"version\\"],\\n      \\"properties\\": {\\n        \\"id\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"version\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 },\\n        \\"uri\\": { \\"$ref\\": \\"#/$defs/identifier\\" },\\n        \\"digest\\": { \\"type\\": \\"string\\", \\"minLength\\": 1 }\\n      }\\n    }\\n  }\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:adapters/discovery/scientific-relations.js",\n            "locator": "workspace:adapters/discovery/scientific-relations.js",\n            "digest": "sha256:bc0e8172310cbecca6c46a77207859760b543368cf379ab26848a906e4028568",\n            "byteLength": 1028,\n            "content": "import { readFileSync } from \\"node:fs\\";\\n\\n// Fixed source-fact data; the Rust registry independently checks admitted use.\\nexport const SCIENTIFIC_SKOS_PREDICATES = Object.freeze({\\n  \\"http://www.w3.org/2004/02/skos/core#exactMatch\\": \\"scientific:exact-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#closeMatch\\": \\"scientific:close-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#broadMatch\\": \\"scientific:broad-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#narrowMatch\\": \\"scientific:narrow-match\\",\\n  \\"http://www.w3.org/2004/02/skos/core#relatedMatch\\":\\n    \\"scientific:related-match\\",\\n});\\nexport function scientificSkosRelationPack() {\\n  const pack = JSON.parse(\\n    readFileSync(\\n      new URL(\\"./profiles/scientific-skos.json\\", import.meta.url),\\n      \\"utf8\\",\\n    ),\\n  );\\n  if (\\n    pack.schemaVersion !== \\"2.0.0\\" ||\\n    pack.id !== \\"urn:metamap:relation-pack:scientific-skos\\" ||\\n    pack.version !== \\"1.0.0\\"\\n  ) {\\n    throw new Error(\\n      \\"Bundled scientific SKOS profile has an unexpected identity\\",\\n    );\\n  }\\n  return pack;\\n}\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:adapters/discovery/sssom.js",\n            "locator": "workspace:adapters/discovery/sssom.js",\n            "digest": "sha256:5a82afd1cae447c9f26b6043ed902fcedb790b975ba3adb575eed731aadb8ae5",\n            "byteLength": 123,\n            "content": "// Source parsing, validation, interpretation and export execute in Rust.\\nexport * from \\"patamaps-native-sdk-draft/sssom\\";\\n"\n          },\n          {\n            "id": "urn:bridge:source:metamap-shard:adapters/discovery/stable.js",\n            "locator": "workspace:adapters/discovery/stable.js",\n            "digest": "sha256:fca250a18b4414d03013d524cf7515f258982570effe806d0ffb73a8e72d6c4a",\n            "byteLength": 831,\n            "content": "import { createHash } from \\"node:crypto\\";\\nexport function stableValue(value) {\\n    if (Array.isArray(value))\\n        return value.map(stableValue);\\n    if (typeof value !== \\"object\\" || va