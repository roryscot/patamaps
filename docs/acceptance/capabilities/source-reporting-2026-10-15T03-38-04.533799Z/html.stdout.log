        {
          &quot;byteLength&quot;: 2996,
          &quot;content&quot;: &quot;{\n  \&quot;schemaVersion\&quot;: \&quot;0.1.0\&quot;,\n  \&quot;id\&quot;: \&quot;urn:metamap:relation-pack:routing\&quot;,\n  \&quot;version\&quot;: \&quot;1.0.0\&quot;,\n  \&quot;description\&quot;: \&quot;Semantic relations for commands, events, routes, handlers, schemas, policies, and endpoints.\&quot;,\n  \&quot;relations\&quot;: [\n    {\n      \&quot;id\&quot;: \&quot;routing:handled_by\&quot;,\n      \&quot;description\&quot;: \&quot;The target handler executes the source command, event, or route.\&quot;,\n      \&quot;sourceKinds\&quot;: [\n        \&quot;routing:command\&quot;,\n        \&quot;routing:event\&quot;,\n        \&quot;routing:route\&quot;\n      ],\n      \&quot;targetKinds\&quot;: [\n        \&quot;routing:handler\&quot;\n      ],\n      \&quot;cardinalities\&quot;: [\n        \&quot;one-to-one\&quot;,\n        \&quot;many-to-one\&quot;\n      ],\n      \&quot;cyclePolicy\&quot;: \&quot;forbid\&quot;,\n      \&quot;impactDirection\&quot;: \&quot;source-to-target\&quot;\n    },\n    {\n      \&quot;id\&quot;: \&quot;routing:accepts\&quot;,\n      \&quot;description\&quot;: \&quot;The source accepts input conforming to the target schema.\&quot;,\n      \&quot;sourceKinds\&quot;: [\n        \&quot;routing:command\&quot;,\n        \&quot;routing:event\&quot;,\n        \&quot;routing:route\&quot;\n      ],\n      \&quot;targetKinds\&quot;: [\n        \&quot;routing:schema\&quot;\n      ],\n      \&quot;cardinalities\&quot;: [\n        \&quot;one-to-one\&quot;,\n        \&quot;many-to-one\&quot;\n      ],\n      \&quot;cyclePolicy\&quot;: \&quot;forbid\&quot;,\n      \&quot;impactDirection\&quot;: \&quot;target-to-source\&quot;\n    },\n    {\n      \&quot;id\&quot;: \&quot;routing:authorized_by\&quot;,\n      \&quot;description\&quot;: \&quot;The source is gated by the target authorization policy.\&quot;,\n      \&quot;sourceKinds\&quot;: [\n        \&quot;routing:command\&quot;,\n        \&quot;routing:event\&quot;,\n        \&quot;routing:route\&quot;\n      ],\n      \&quot;targetKinds\&quot;: [\n        \&quot;routing:policy\&quot;\n      ],\n      \&quot;cardinalities\&quot;: [\n        \&quot;one-to-one\&quot;,\n        \&quot;many-to-one\&quot;,\n        \&quot;many-to-many\&quot;\n      ],\n      \&quot;cyclePolicy\&quot;: \&quot;forbid\&quot;,\n      \&quot;impactDirection\&quot;: \&quot;target-to-source\&quot;\n    },\n    {\n      \&quot;id\&quot;: \&quot;routing:emits\&quot;,\n      \&quot;description\&quot;: \&quot;Executing the source may emit the target event.\&quot;,\n      \&quot;sourceKinds\&quot;: [\n        \&quot;routing:command\&quot;,\n        \&quot;routing:handler\&quot;,\n        \&quot;routing:route\&quot;\n      ],\n      \&quot;targetKinds\&quot;: [\n        \&quot;routing:event\&quot;\n      ],\n      \&quot;cardinalities\&quot;: [\n        \&quot;one-to-one\&quot;,\n        \&quot;one-to-many\&quot;,\n        \&quot;many-to-many\&quot;\n      ],\n      \&quot;cyclePolicy\&quot;: \&quot;allow\&quot;,\n      \&quot;impactDirection\&quot;: \&quot;source-to-target\&quot;\n    },\n    {\n      \&quot;id\&quot;: \&quot;routing:exposed_as\&quot;,\n      \&quot;description\&quot;: \&quot;The source semantic operation is exposed through the target transport endpoint.\&quot;,\n      \&quot;sourceKinds\&quot;: [\n        \&quot;routing:command\&quot;,\n        \&quot;routing:event\&quot;,\n        \&quot;routing:route\&quot;\n      ],\n      \&quot;targetKinds\&quot;: [\n        \&quot;routing:endpoint\&quot;\n      ],\n      \&quot;cardinalities\&quot;: [\n        \&quot;one-to-one\&quot;,\n        \&quot;one-to-many\&quot;,\n        \&quot;many-to-many\&quot;\n      ],\n      \&quot;cyclePolicy\&quot;: \&quot;forbid\&quot;,\n      \&quot;impactDirection\&quot;: \&quot;both\&quot;\n    },\n    {\n      \&quot;id\&quot;: \&quot;routing:transitions_to\&quot;,\n      \&quot;description\&quot;: \&quot;The source workflow state permits a transition to the target state.\&quot;,\n      \&quot;sourceKinds\&quot;: [\n        \&quot;routing:state\&quot;\n      ],\n      \&quot;targetKinds\&quot;: [\n        \&quot;routing:state\&quot;\n      ],\n      \&quot;cardinalities\&quot;: [\n        \&quot;one-to-one\&quot;,\n        \&quot;one-to-many\&quot;,\n        \&quot;many-to-many\&quot;\n      ],\n      \&quot;cyclePolicy\&quot;: \&quot;allow\&quot;,\n      \&quot;impactDirection\&quot;: \&quot;both\&quot;\n    }\n  ],\n  \&quot;documentType\&quot;: \&quot;relation-pack\&quot;\n}\n&quot;,
