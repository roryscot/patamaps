            "content": "{\n  \"schemaVersion\": \"0.1.0\",\n  \"id\": \"urn:example:routing:graph\",\n  \"namespace\": \"routing-example\",\n  \"label\": \"Example semantic command router\",\n  \"revision\": \"1\",\n  \"relationPacks\": [\n    {\n      \"id\": \"urn:metamap:relation-pack:core\",\n      \"version\": \"1.0.0\"\n    },\n    {\n      \"id\": \"urn:metamap:relation-pack:routing\",\n      \"version\": \"1.0.0\"\n    }\n  ],\n  \"entities\": [\n    {\n      \"id\": \"urn:example:command:create-user\",\n      \"kind\": \"routing:command\",\n      \"label\": \"Create user\"\n    },\n    {\n      \"id\": \"urn:example:handler:create-user\",\n      \"kind\": \"routing:handler\",\n      \"label\": \"Create user handler\",\n      \"locators\": [\n        {\n          \"uri\": \"typescript:src/identity/create-user.ts#handleCreateUser\"\n        },\n        {\n          \"uri\": \"rust:crate::service::greet\"\n        }\n      ]\n    },\n    {\n      \"id\": \"urn:example:schema:create-user\",\n      \"kind\": \"routing:schema\",\n      \"label\": \"Create user input\",\n      \"locators\": [\n        {\n          \"uri\": \"json-schema:schemas/create-user.json\"\n        }\n      ]\n    },\n    {\n      \"id\": \"urn:example:policy:identity-admin\",\n      \"kind\": \"routing:policy\",\n      \"label\": \"Identity administrator\"\n    },\n    {\n      \"id\": \"urn:example:endpoint:create-user\",\n      \"kind\": \"routing:endpoint\",\n      \"label\": \"POST /users\",\n      \"attributes\": {\n        \"method\": \"POST\",\n        \"path\": \"/users\"\n      }\n    },\n    {\n      \"id\": \"urn:example:event:user-created\",\n      \"kind\": \"routing:event\",\n      \"label\": \"User created\"\n    }\n  ],\n  \"mappings\": [\n    {\n      \"id\": \"urn:example:mapping:create-user-handler\",\n      \"relation\": \"routing:handled_by\",\n      \"sources\": [\n        \"urn:example:command:create-user\"\n      ],\n      \"targets\": [\n        \"urn:example:handl