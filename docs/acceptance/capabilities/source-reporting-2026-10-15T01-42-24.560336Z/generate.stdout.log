      "bindings.rs": "// Generated from sha256:8ad8e0b3cdee36ee84e34bb7cd28cf9d75bfb9df293b8915f3214258b1bc55d0; regenerate after correspondence changes.\npub const PROJECTION_JSON: &str = \"{\\\"digest\\\":\\\"sha256:8ad8e0b3cdee36ee84e34bb7cd28cf9d75bfb9df293b8915f3214258b1bc55d0\\\",\\\"documentType\\\":\\\"projection\\\",\\\"entries\\\":[{\\\"slots\\\":[{\\\"cardinality\\\":\\\"exactly-one\\\",\\\"direction\\\":\\\"outgoing\\\",\\\"mappings\\\":[\\\"urn:example:mapping:create-user-policy\\\"],\\\"name\\\":\\\"authorization\\\",\\\"relation\\\":\\\"routing:authorized_by\\\",\\\"targets\\\":[{\\\"id\\\":\\\"urn:example:policy:identity-admin\\\",\\\"kind\\\":\\\"routing:policy\\\",\\\"label\\\":\\\"Identity administrator\\\"}]},{\\\"cardinality\\\":\\\"many\\\",\\\"direction\\\":\\\"outgoing\\\",\\\"mappings\\\":[\\\"urn:example:mapping:create-user-event\\\"],\\\"name\\\":\\\"emits\\\",\\\"relation\\\":\\\"routing:emits\\\",\\\"targets\\\":[{\\\"id\\\":\\\"urn:example:event:user-created\\\",\\\"kind\\\":\\\"routing:event\\\",\\\"label\\\":\\\"User created\\\"}]},{\\\"cardinality\\\":\\\"one-or-more\\\",\\\"direction\\\":\\\"outgoing\\\",\\\"mappings\\\":[\\\"urn:example:mapping:create-user-endpoint\\\"],\\\"name\\\":\\\"endpoints\\\",\\\"relation\\\":\\\"routing:exposed_as\\\",\\\"targets\\\":[{\\\"attributes\\\":{\\\"method\\\":\\\"POST\\\",\\\"path\\\":\\\"/users\\\"},\\\"id\\\":\\\"urn:example:endpoint:create-user\\\",\\\"kind\\\":\\\"routing:endpoint\\\",\\\"label\\\":\\\"POST /users\\\"}]},{\\\"cardinality\\\":\\\"exactly-one\\\",\\\"direction\\\":\\\"outgoing\\\",\\\"mappings\\\":[\\\"urn:example:mapping:create-user-handler\\\"],\\\"name\\\":\\\"handler\\\",\\\"relation\\\":\\\"routing:handled_by\\\",\\\"targets\\\":[{\\\"id\\\":\\\"urn:example:handler:create-user\\\",\\\"kind\\\":\\\"routing:handler\\\",\\\"label\\\":\\\"Create user handler\\\",\\\"locators\\\":[{\\\"uri\\\":\\\"typescript:src/identity/create-user.ts#handleCreateUser\\\"},{\\\"uri\\\":\\\"rust:crate::service::greet\\\"}]}]},{\\\"cardinality\\\":\\\"exactly-one\\\",\\\"direction\\\":\\\"outgoing\\\",\\\"mappings\\\":[\\\"urn:example:mapping:create-user-input\\\"],\\\"name\\\":\\\"input\\\",\\\"relation\\\":\\\"routing:accepts\\\",\\\"targets\\\":[{\\\"id\\\":\\\"urn:example:schema:create-user\\\",\\\"kind\\\":\\\"routing:schema\\\",\\\"label\\\":\\\"Create user input\\\",\\\"locators\\\":[{\\\"uri\\\":\\\"json-schema:schemas/create-user.json\\\"}]}]}],\\\"subject\\\":{\\\"id\\\":\\\"urn:example:command:create-user\\\",\\\"kind\\\":\\\"routing:command\\\",\\\"label\\\":\\\"Create user\\\"}}],\\\"generation\\\":{\\\"digest\\\":\\\"sha256:bbc6fc349c962df530a512f2f59e169ca81a8e38e39e58452281a661bba335c7\\\",\\\"id\\\":\\\"urn:patamaps:generation:bbc6fc349c962df530a512f2f59e169ca81a8e38e39e58452281a661bba335c7\\\"},\\\"graph\\\":{\\\"digest\\\":\\\"sha256:86b7b8ff9923ec1cd983ee782cea026ddaffd85bffbe1285804f87680e1df06b\\\",\\\"id\\\":\\\"urn:workspace:source-reporting\\\",\\\"revision\\\":\\\"1\\\"},\\\"id\\\":\\\"urn:patamaps:projection:8ad8e0b3cdee36ee84e34bb7cd28cf9d75bfb9df293b8915f3214258b1bc55d0\\\",\\\"profile\\\":\\\"patamaps-routing-draft-1\\\",\\\"schemaVersion\\\":\\\"0.1.0\\\",\\\"spec\\\":{\\\"digest\\\":\\\"sha256:d497bc82ce233eabf90024af0d329915e2ac0ea80efcdf80bbecadb7e798b132\\\",\\\"id\\\":\\\"urn:example:projection:command-router\\\"}}\";\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct SemanticId(&'static str);\nimpl SemanticId {\n  pub fn as_str(self) -> &'static str { self.0 }\n  pub fn parse(id: &str) -> Option<Self> {\n    match id {\n      \"urn:example:command:create-user\" => Some(Self(\"urn:example:command:create-user\")),\n      _ => None,\n    }\n  }\n}\npub fn dispatch(id: SemanticId, input: &str) -> String {\n  match id.as_str() {\n    \"urn:example:command:create-user\" => crate::service::greet(input),\n    _ => unreachable!(\"SemanticId can only be constructed from known identities\"),\n  }\n}\n"
