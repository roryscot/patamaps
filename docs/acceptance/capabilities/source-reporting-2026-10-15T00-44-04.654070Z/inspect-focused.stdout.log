        {
          "byteLength": 2996,
          "content": "{\n  \"schemaVersion\": \"0.1.0\",\n  \"id\": \"urn:metamap:relation-pack:routing\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Semantic relations for commands, events, routes, handlers, schemas, policies, and endpoints.\",\n  \"relations\": [\n    {\n      \"id\": \"routing:handled_by\",\n      \"description\": \"The target handler executes the source command, event, or route.\",\n      \"sourceKinds\": [\n        \"routing:command\",\n        \"routing:event\",\n        \"routing:route\"\n      ],\n      \"targetKinds\": [\n        \"routing:handler\"\n      ],\n      \"cardinalities\": [\n        \"one-to-one\",\n        \"many-to-one\"\n      ],\n      \"cyclePolicy\": \"forbid\",\n      \"impactDirection\": \"source-to-target\"\n    },\n    {\n      \"id\": \"routing:accepts\",\n      \"description\": \"The source accepts input conforming to the target schema.\",\n      \"sourceKinds\": [\n        \"routing:command\",\n        \"routing:event\",\n        \"routing:route\"\n      ],\n      \"targetKinds\": [\n        \"routing:schema\"\n      ],\n      \"cardinalities\": [\n        \"one-to-one\",\n        \"many-to-one\"\n      ],\n      \"cyclePolicy\": \"forbid\",\n      \"impactDirection\": \"target-to-source\"\n    },\n    {\n      \"id\": \"routing:authorized_by\",\n      \"description\": \"The source is gated by the target authorization policy.\",\n      \"sourceKinds\": [\n        \"routing:command\",\n        \"routing:event\",\n        \"routing:route\"\n      ],\n      \"targetKinds\": [\n        \"routing:policy\"\n      ],\n      \"cardinalities\": [\n        \"one-to-one\",\n        \"many-to-one\",\n        \"many-to-many\"\n      ],\n      \"cyclePolicy\": \"forbid\",\n      \"impactDirection\": \"target-to-source\"\n    },\n    {\n      \"id\": \"routing:emits\",\n      \"description\": \"Executing the source may emit the target event.\",\n      \"sourceKinds\": [\n        \"routing:command\",\n        \"routing:handler\",\n        \"routing:route\"\n      ],\n      \"targetKinds\": [\n        \"routing:event\"\n      ],\n      \"cardinalities\": [\n        \"one-to-one\",\n        \"one-to-many\",\n        \"many-to-many\"\n      ],\n      \"cyclePolicy\": \"allow\",\n      \"impactDirection\": \"source-to-target\"\n    },\n    {\n      \"id\": \"routing:exposed_as\",\n      \"description\": \"The source semantic operation is exposed through the target transport endpoint.\",\n      \"sourceKinds\": [\n        \"routing:command\",\n        \"routing:event\",\n        \"routing:route\"\n      ],\n      \"targetKinds\": [\n        \"routing:endpoint\"\n      ],\n      \"cardinalities\": [\n        \"one-to-one\",\n        \"one-to-many\",\n        \"many-to-many\"\n      ],\n      \"cyclePolicy\": \"forbid\",\n      \"impactDirection\": \"both\"\n    },\n    {\n      \"id\": \"routing:transitions_to\",\n      \"description\": \"The source workflow state permits a transition to the target state.\",\n      \"sourceKinds\": [\n        \"routing:state\"\n      ],\n      \"targetKinds\": [\n        \"routing:state\"\n      ],\n      \"cardinalities\": [\n        \"one-to-one\",\n        \"one-to-many\",\n        \"many-to-many\"\n      ],\n      \"cyclePolicy\": \"allow\",\n      \"impactDirection\": \"both\"\n    }\n  ],\n  \"documentType\": \"relation-pack\"\n}\n",
