        {
          "byteLength": 1958,
          "content": "{\n  \"schemaVersion\": \"0.1.0\",\n  \"id\": \"urn:example:routing:viability\",\n  \"graph\": {\n    \"id\": \"urn:workspace:source-reporting\",\n    \"revision\": \"1\"\n  },\n  \"mappings\": [\n    {\n      \"mapping\": \"urn:example:mapping:create-user-handler\",\n      \"coverage\": \"total\",\n      \"determinism\": \"deterministic\",\n      \"reversibility\": \"irreversible\"\n    },\n    {\n      \"mapping\": \"urn:example:mapping:create-user-input\",\n      \"coverage\": \"total\",\n      \"determinism\": \"deterministic\",\n      \"reversibility\": \"irreversible\"\n    },\n    {\n      \"mapping\": \"urn:example:mapping:create-user-policy\",\n      \"coverage\": \"total\",\n      \"determinism\": \"deterministic\",\n      \"reversibility\": \"irreversible\"\n    },\n    {\n      \"mapping\": \"urn:example:mapping:create-user-endpoint\",\n      \"coverage\": \"total\",\n      \"determinism\": \"deterministic\",\n      \"reversibility\": \"irreversible\"\n    },\n    {\n      \"mapping\": \"urn:example:mapping:create-user-event\",\n      \"coverage\": \"partial\",\n      \"determinism\": \"deterministic\",\n      \"reversibility\": \"irreversible\"\n    }\n  ],\n  \"constraints\": [\n    {\n      \"id\": \"urn:example:constraint:create-user-handler-required\",\n      \"kind\": \"core:requires-mapping\",\n      \"subjects\": [\n        \"urn:example:command:create-user\"\n      ],\n      \"parameters\": {\n        \"relation\": \"routing:handled_by\",\n        \"direction\": \"source\"\n      }\n    },\n    {\n      \"id\": \"urn:example:constraint:create-user-handler-unique\",\n      \"kind\": \"core:unique-target\",\n      \"subjects\": [\n        \"urn:example:command:create-user\"\n      ],\n      \"parameters\": {\n        \"relation\": \"routing:handled_by\",\n        \"direction\": \"source\"\n      }\n    },\n    {\n      \"id\": \"urn:example:constraint:create-user-routing-authority\",\n      \"kind\": \"core:requires-authority\",\n      \"subjects\": [\n        \"urn:example:command:create-user\"\n      ],\n      \"parameters\": {\n        \"fact\": \"routing-identity\"\n      }\n    }\n  ],\n  \"evidence\": [],\n  \"documentType\": \"policy\"\n}\n",
