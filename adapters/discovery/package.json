{
  "name": "patamaps-discovery-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "patamaps-native-sdk-draft": "0.1.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
