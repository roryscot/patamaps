    "./prisma": {
      "types": "./adapters/prisma.d.ts",
      "import": "./adapters/prisma.js"
    },
    "./typescript-zod": {
      "types": "./adapters/typescript-zod.d.ts",
      "import": "./adapters/typescript-zod.js"
    },
    "./nextjs-app-router": {
      "types": "./adapters/nextjs-app-router.d.ts",
      "import": "./adapters/nextjs-app-router.js"
    },
    "./json-collections": {
      "types": "./adapters/json-collections.d.ts",
      "import": "./adapters/json-collections.js"
    },
    "./legacy-sources": {
      "types": "./adapters/legacy-sources.d.ts",
      "import": "./adapters/legacy-sources.js"
    },
    "./sssom-tsv": {
      "types": "./adapters/sssom-tsv.d.ts",
      "import": "./adapters/sssom-tsv.js"
    },
    "./metamap-shard": {
      "types": "./adapters/metamap-shard.d.ts",
