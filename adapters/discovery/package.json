    "references.js",
    "references.d.ts",
    "stable.js",
    "stable.d.ts",
    "config.d.ts",
    "index.mjs",
    "index.d.ts",
    "process.mjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "provenance.json"
  ]
